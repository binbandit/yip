# Build output
/bin/
/yip
/dist/
*.test
*.out

# Local runtime data (hub/runner state, databases, artifacts)
/.yip/
/data/
*.db
*.db-wal
*.db-shm

# Web client
/web/node_modules
/web/dist/*
!/web/dist/.gitkeep
/web/.svelte-kit/
/web/.vite/

# Keep README screenshots, not historical capture batches.
/docs/screenshots/*/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local agent worktrees
/.claude/worktrees/

# Python fixture caches
__pycache__/
